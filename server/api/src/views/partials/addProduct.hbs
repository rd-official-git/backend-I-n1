<div class="add-product">
    <h1>Add Product</h1>
    <div id="formDiv">
        <form action="/realtimeproducts/add" method="POST" id="addProductForm">
            <fieldset>
                <legend>Product details</legend>
                <div class="form-group">
                    <label for="productDetails"></label><textarea rows="10" cols="40" id="productDetails"></textarea>
                    <br>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn-submit" id="btnSubmit" onclick="convertToJson()">Add</button>
                </div>
            </fieldset>
        </form>
    </div>

    <script>
        function convertToJson() {
            const textareaValue = document.getElementById("productDetails").value;
            console.log(`textareaValue: ${textareaValue}`);
            try {
                const jsonObject = JSON.parse(textareaValue);
                document.getElementById("productDetails").textContent = JSON.stringify(jsonObject, null, 2);
                console.log(`Converted JSON: ${jsonObject}`);
                socket.emit("", jsonObject);
            } catch (error) {
                document.getElementById("productDetails").textContent = "Incorrect JSON";
                console.error(`Error converting to JSON: ${error}`);
            }

        }
    </script>
</div>

