<div class="delete-product">
    <h1>Delete Product</h1>
    <div id="formDiv">
        <form id="deleteProductForm">
            <fieldset>
                <legend>Product id</legend>
                <table id="deleteProductTable">
                    <tr>
                        <td><label for="productId">Product id to be deleted</label></td>
                        <td><input id="productId" type=text></td>
                    </tr>
                </table>
                <div class="form-group">
                    <button type="submit" class="btn-submit" id="btnSubmit">Submit</button>
                </div>
            </fieldset>
        </form>
    </div>
</div>